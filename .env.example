# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database Configuration
DATABASE_PATH=data/campus.db

# Supabase Authentication (Email OTP & User Identity)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Gmail SMTP Email Configuration (Student OTP Login & Transactional Booking Confirmations)
# Generate a 16-character Google App Password under Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your.college.project@gmail.com
EMAIL_APP_PASSWORD=your_16_character_app_password
EMAIL_SENDER_NAME=CampusPilot AI
